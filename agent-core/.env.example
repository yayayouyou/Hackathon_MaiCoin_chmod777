# ================================
# AI Crypto Trading Agent — 環境變數範本
# 複製此檔案為 .env 並填入真實 Key
# 注意：.env 不可 commit 到 Git！
# 不設定任何私有 Key 時，約 80% 的公開行情/指標/回測技能仍可正常運作。
# ================================

# ---- LLM 供應商切換 ----
# bedrock = Amazon Bedrock（命題限用 AWS 基礎模型，正式 demo 走這條）
# ollama = 本機零成本；openrouter = Bedrock 掛掉時的續命路徑
LLM_PROVIDER=ollama

# ---- Amazon Bedrock（LLM_PROVIDER=bedrock 時生效）----
# 驗證用：python scripts/bedrock_check.py    （會列出這個帳號實際可用的 model id）
BEDROCK_REGION=us-west-2
# 新模型多半只能用「跨區推理設定檔」id（us./eu./apac. 開頭），直接填基礎模型 id 會 ValidationException
BEDROCK_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
#
# 憑證不寫在這裡也可以，boto3 會依序找：環境變數 → AWS_PROFILE（~/.aws）→ IAM Role。
# 黑客松給的是「臨時憑證」，三個一組且會過期，缺 SESSION_TOKEN 一定 401：
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# 或走 IAM Identity Center：aws configure sso  然後只設 profile 名稱
# AWS_PROFILE=

# ---- LLM 大腦 (Ollama) ----
# Ollama 伺服器位址（本機預設）
OLLAMA_HOST=http://127.0.0.1:11434
# 若你的 Ollama 需要 HTTP Basic Auth，才需填以下兩項（否則留空）
OLLAMA_USER=
OLLAMA_PASSWORD=

# ---- 交易所 API Keys ----
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# OKX
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# MAX (台灣交易所) — 申請：https://max.maicoin.com/apikeys
MAX_API_KEY=your_max_api_key_here
MAX_API_SECRET=your_max_api_secret_here

# Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# ---- 市場情報 API (選填) ----
# CoinGecko Demo API key（免費，10k credits/月、100 calls/min；免 key 也能用但限流較嚴）
# 申請：https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_demo_key_here
# CoinMarketCap（get_cmc_* 工具需要）
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
# CoinGlass（付費 v4 端點才需要；免 Key 抓取工具不需要）
COINGLASS_API_KEY=your_coinglass_api_key_here
# Coinalyze（免費！跨 ~25 所爆倉/持倉彙整；供爆倉工具與熱力圖跨所 OI）
# 申請：https://coinalyze.net/account/api-settings （免付費、40 req/min）
COINALYZE_API_KEY=your_coinalyze_api_key_here
# SoSoValue（免費！第一方美國現貨 BTC/ETH ETF 每日流向；取代脆弱爬蟲）
# 申請：https://sosovalue.com/developer （Demo 免付費、~20 req/min）
SOSOVALUE_API_KEY=your_sosovalue_api_key_here

# ---- 黃金總經 API (選填，供 get_gold_macro_context / analyze_gold_market 的總經層) ----
# FRED（美國聖路易聯準會，免費）：實質利率/美元指數/CPI/政策利率/倫敦金定盤，一把 Key 全包
# 申請：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
# Alpha Vantage（免費，FRED 缺 Key 時的部分備援；免費層限流 ~25次/日、5次/分）
# 申請：https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# ---- 預設設定 ----
DEFAULT_EXCHANGE=binance
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAME=1h

# ---- 交易安全模式 ----
# paper = 模擬盤（安全預設，不送出真實訂單）；live = 實盤（會送出真實 MAX 訂單！）
RISK_MODE=paper

# ---- 實盤四道防線（RISK_MODE=live 時才生效）----
# 1) 授權到期：只設 RISK_MODE=live 不會啟用實盤，還必須設這個到期時間。
#    過期後自動退回模擬盤，強迫你定期重新確認（避免「設一次就永久開著」）。
#    格式：YYYY-MM-DD（該日整天有效）或完整 ISO 時間。
# LIVE_UNTIL=2026-08-05
#
# 2) 累計曝險上限：單筆上限擋不住「連續下十筆都剛好低於上限」。
LIVE_WINDOW_HOURS=24            # 滾動視窗
LIVE_MAX_NOTIONAL_TWD=200000    # 視窗內下單總額上限
LIVE_MAX_ORDERS=20              # 視窗內筆數上限（擋高頻迴圈）
#
# 3) 全域停止開關：建立 conversation_logs/TRADING_HALTED 這個檔案即全面停手，
#    不必改設定也不必重啟；刪掉檔案即恢復。出事當下用 `touch` 最快。
#
# 4) 決策台帳：每次下單決策（含被擋下的）寫進 conversation_logs/order_ledger.jsonl，
#    累計曝險也由它計算。可用 get_trading_guard_status 工具查詢。

# ---- 交易核准互鎖 (human-in-the-loop) ----
# always（預設）= 每筆下單都要在介面點擊核准（連模擬盤也要，最安全）
# allowlist      = 名目價值 ≤ TRADE_AUTO_APPROVE_TWD 者自動核准，其餘要核准
# off            = 不啟用核准，模型下單直接執行（不建議）
TRADE_APPROVAL=always
TRADE_AUTO_APPROVE_TWD=5000

# ---- 不可信內容淨化 (Reader Agent) ----
# llm（預設）= 確定性遮蔽 + LLM 摘要；heuristic = 只做遮蔽(零延遲)；off = 不淨化(不建議)
READER_AGENT=llm

# ---- gemma4 原生思考模式 ----
# off（預設）= 不思考(最快)；on = 每輪都思考；auto = 僅多空分析類問題才思考
AGENT_THINK=auto
# 以下由自動化引擎 (automation/, Phase 1) 讀取
MAX_LOSS_PER_TRADE_USDT=100
MAX_LEVERAGE=1

# ---- 代理設定（選填）----
# USE_PROXY=false
# PROXY_URL=http://username:password@proxy-server:port
